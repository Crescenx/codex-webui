{
  "name": "codex-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc --noEmit && vite build",
    "start": "node server/main.ts",
    "test": "node --test test/*.test.ts",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:live": "node scripts/live.ts",
    "service:install": "node scripts/service.ts"
  },
  "dependencies": {
    "ansi-regex": "^6.3.0",
    "ansi-to-html": "^0.7.2",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
