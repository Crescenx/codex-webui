{
  "name": "codex-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json && vite build",
    "start": "node server/main.ts",
    "test": "node --test test/*.test.ts",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:live": "node scripts/live.ts",
    "service:install": "node scripts/service.ts",
    "shortcut:install": "node scripts/shortcut.ts",
    "open": "node scripts/open.ts",
    "build:obsidian": "vue-tsc --noEmit -p tsconfig.obsidian.json && vite build --config vite.obsidian.config.ts && node scripts/package-obsidian.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tanstack/vue-virtual": "^3.13.38",
    "ansi-regex": "^6.3.0",
    "ansi-to-html": "^0.7.2",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "mermaid": "12.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.2",
    "mdast-util-from-markdown": "^2.0.0",
    "micromark-util-types": "^2.0.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vue-tsc": "^3.3.11"
  }
}
